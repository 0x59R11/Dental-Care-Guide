{
  "name": "dental-care-guide",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:links": "node scripts/check-build.mjs",
    "test:performance": "node scripts/check-performance.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run format:check && npm run check && npm run build && npm run test:links",
    "prebuild": "npm test",
    "test:sources": "node scripts/check-sources.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.6",
    "@astrojs/sitemap": "3.7.5",
    "astro": "7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "lighthouse": "13.6.0",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
