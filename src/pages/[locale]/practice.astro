---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import Illustration from '../../components/illustrations/Illustration.astro';
import CareMotif, {
  type CareMotif as Motif,
} from '../../components/illustrations/CareMotif.astro';
import { locales, type Locale } from '../../i18n/locales';
import { ui } from '../../i18n/ui';
import { localeUrl } from '../../lib/urls';
import { getRecommendations } from '../../lib/content';
import { routineGroups } from '../../data/course';
import { sources } from '../../data/sources';
export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}
const locale = Astro.params.locale as Locale;
const t = ui(locale);
const cards = getRecommendations(locale);
const careMotifs: Record<string, Motif> = {
  'brush-with-fluoride': 'paste',
  'brush-gently': 'brush',
  'spit-dont-rinse': 'paste',
  'reduce-sugar': 'snack',
  'limit-acid-exposure': 'drink',
  'choose-water': 'water',
  'optional-gum': 'drop',
  'after-acids': 'water',
  'clean-between-teeth': 'floss',
  'brush-before-bed': 'brush',
  'finish-food-first': 'moon',
  'personal-checkups': 'calendar',
  'discuss-dry-mouth': 'drop',
  'get-care-when-needed': 'calendar',
};
---

<SiteLayout
  locale={locale}
  title={t.practice}
  description={t.practiceIntro}
  path="practice/"
  section="practice"
>
  <div class="container page-space">
    <PageIntro
      eyebrow={t.practice}
      title={t.practiceTitle}
      description={t.practiceIntro}
    />
    <nav class="routine-nav" aria-label={t.routineNav}>
      {routineGroups.map((group, index) => (
        <a href={`#${group}`}>
          <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          {t[group]}
        </a>
      ))}
    </nav>
    {routineGroups.map((group) => (
      <section id={group} class="routine-section">
        <div class="section-heading">
          <div class="routine-art">
            <Illustration variant={group} />
          </div>
          <div>
            <h2>{t[group]}</h2>
            <p class="muted">{t[`${group}Note`]}</p>
          </div>
        </div>
        <div class="practice-grid">
          {cards
            .filter((card) => card.group === group)
            .map((card) => (
              <article class="card practice-card" id={card.id}>
                <div class="practice-card-heading">
                  <svg
                    class="practice-motif"
                    viewBox="0 0 100 100"
                    aria-hidden="true"
                  >
                    <CareMotif kind={careMotifs[card.id]} />
                  </svg>
                  <h3>{card.title}</h3>
                </div>
                <p>{card.instruction}</p>
                <details>
                  <summary>{t.why}</summary>
                  <p>{card.why}</p>
                  <ul class="text-small">
                    {card.sourceIds.map((id) => {
                      const source = sources.find(
                        (source) => source.id === id,
                      )!;
                      return (
                        <li>
                          <a href={source.url}>
                            {source.publisher}: {source.titles[locale]}
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </details>
                <a
                  class="related-link"
                  href={localeUrl(locale, `learn/${card.lessonId}/`)}
                >
                  {t.related} →
                </a>
              </article>
            ))}
        </div>
      </section>
    ))}
    <aside class="principle">
      <div>
        <h2>{t.practiceEnd}</h2>
        <p>{t.practiceEndText}</p>
        <a class="button" href={localeUrl(locale, 'test/')}>
          {t.test} →
        </a>
      </div>
    </aside>
  </div>
</SiteLayout>
