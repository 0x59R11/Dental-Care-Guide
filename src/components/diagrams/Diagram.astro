---
import CareMotif from '../illustrations/CareMotif.astro';
import Tooth from './Tooth.astro';
import LesionStages from './LesionStages.astro';
import { diagrams } from '../../i18n/diagrams';
import { ui } from '../../i18n/ui';
import type { Locale } from '../../i18n/locales';
import type { DiagramId } from '../../data/course';
interface Props {
  locale: Locale;
  diagramId: DiagramId;
}
const { locale, diagramId } = Astro.props;
const copy = diagrams[locale][diagramId];
const t = ui(locale);
---

<figure class="diagram card" data-diagram>
  <figcaption>
    <p class="eyebrow">{t.diagram}</p>
    <h2>{copy.title}</h2>
    <p class="text-small muted">{t.schematic}</p>
    {diagramId === 'dark-spots' && <p class="text-small">{t.notDiagnostic}</p>}
  </figcaption>
  <div class="diagram-layout">
    <div class="diagram-art">
      {diagramId === 'understanding-teeth' ? (
        <Tooth decorative={false} title={copy.title} />
      ) : (
        <svg
          viewBox="0 0 360 270"
          role="img"
          aria-label={copy.title}
          class="process-svg"
        >
          {diagramId === 'how-cavities-develop' && (
            <>
              <path d="M35 135H325" class="connector" />
              {[0, 1, 2, 3].map((step) => (
                <g
                  data-region={step}
                  transform={`translate(${7 + step * 89},35)`}
                >
                  <rect
                    width="78"
                    height="200"
                    rx="24"
                    class={`stage stage-${step}`}
                  />
                  <g class="diagram-marker">
                    <circle cx="39" cy="25" r="14" />
                    <text x="39" y="29" text-anchor="middle">
                      {step + 1}
                    </text>
                  </g>
                  <path d="M7 145H71V178H7Z" class="dentin" />
                  <path d="M7 137H71V149H7Z" class="enamel" />
                  <path
                    d="M7 120Q23 111 39 120T71 120V136H7Z"
                    fill="var(--soft)"
                    stroke="var(--accent)"
                    stroke-dasharray="3 3"
                  />
                  {[18, 32, 46, 60].map((x, i) => (
                    <ellipse
                      cx={x}
                      cy={130 - (i % 2) * 7}
                      rx="6"
                      ry="4"
                      fill="var(--accent)"
                      transform={`rotate(${i % 2 ? 25 : -25} ${x} 130)`}
                    />
                  ))}
                  {step === 1 && (
                    <g class="dentin">
                      <rect
                        x="18"
                        y="65"
                        width="16"
                        height="16"
                        rx="2"
                        transform="rotate(20 26 73)"
                      />
                      <rect
                        x="48"
                        y="87"
                        width="16"
                        height="16"
                        rx="2"
                        transform="rotate(-15 56 95)"
                      />
                    </g>
                  )}
                  {step === 2 && (
                    <g class="pulp">
                      <path d="M25 65q-14 24 0 24t0-24M53 85q-14 24 0 24t0-24" />
                    </g>
                  )}
                  {step === 3 && (
                    <>
                      <path
                        d="M24 146v-12m15 12v-12m15 12v-12"
                        stroke="var(--dentin)"
                        stroke-width="5"
                      />
                      <circle cx="22" cy="100" r="4" class="dentin" />
                      <circle cx="43" cy="80" r="4" class="dentin" />
                      <circle cx="59" cy="104" r="4" class="dentin" />
                      <path d="M39 117v-14m-5 6 5-6 5 6" class="arrow-path" />
                    </>
                  )}
                </g>
              ))}
            </>
          )}
          {diagramId === 'sugar-food-and-acids' && (
            <>
              <path d="M112 65H330M112 145H330M112 225H330" class="connector" />
              {[0, 1, 2].map((row) => (
                <g data-region={row}>
                  <g class="diagram-marker">
                    <circle cx="16" cy={65 + 80 * row} r="13" />
                    <text x="16" y={69 + 80 * row} text-anchor="middle">
                      {row + 1}
                    </text>
                  </g>
                  <CareMotif kind="drink" x={32} y={20 + 80 * row} size={76} />
                  {(row === 1
                    ? [125, 164, 203, 242, 281, 320]
                    : [125, 147, 169]
                  ).map((x) => (
                    <circle
                      cx={x}
                      cy={65 + row * 80}
                      r="10"
                      class={row === 2 ? 'pulp' : 'dentin'}
                    />
                  ))}
                  {row === 2 && (
                    <path d="m230 210-12 29h24z m48 0-12 29h24z" class="pulp" />
                  )}
                </g>
              ))}
            </>
          )}
          {diagramId === 'saliva-and-fluoride' && (
            <>
              <rect
                x="16"
                y="12"
                width="328"
                height="242"
                rx="24"
                fill="var(--blue)"
              />
              <CareMotif kind="drop" x={145} y={45} size={38} />
              <CareMotif kind="paste" x={182} y={49} size={38} />
              <path d="M30 170H330V240H30Z" class="enamel" />
              {[60, 110, 160, 210, 260, 310].map((x) => (
                <rect
                  x={x - 12}
                  y="185"
                  width="24"
                  height="24"
                  rx="4"
                  class="dentin"
                />
              ))}
              <g data-region="0">
                <path d="M95 155V65m-12 15 12-15 12 15" class="arrow-path" />
                <circle cx="65" cy="105" r="8" class="dentin" />
                <text x="95" y="40" text-anchor="middle">
                  1
                </text>
              </g>
              <g data-region="1">
                <path d="M265 65V155m-12-15 12 15 12-15" class="arrow-path" />
                <circle cx="295" cy="105" r="8" class="dentin" />
                <text x="265" y="40" text-anchor="middle">
                  2
                </text>
              </g>
            </>
          )}
          {(diagramId === 'dark-spots' || diagramId === 'lesion-depth') && (
            <LesionStages diagramId={diagramId} />
          )}
          {diagramId === 'when-problems-progress' && (
            <>
              <path
                d="M108 135H163M163 45v180M163 45h67M163 135h67M163 225h67"
                class="connector"
              />
              {[
                [12, 92],
                [234, 2],
                [234, 92],
                [234, 182],
              ].map(([x, y], i) => (
                <g data-region={i} transform={`translate(${x} ${y})`}>
                  <rect width="112" height="86" rx="16" class="stage" />
                  <path
                    d="M31 72Q15 42 32 23q10-9 24-1 14-8 24 1 17 19 1 49Z"
                    class="enamel"
                  />
                  <path
                    d="M39 72Q26 45 39 34q8-5 17 0 9-5 17 0 13 11 0 38Z"
                    class="dentin"
                  />
                  <path d="M48 72V54q-6-12 8-8 14-4 8 8v18Z" class="pulp" />
                  <path
                    d={
                      i === 1
                        ? 'M47 21h18l5 24-14 9-14-9Z'
                        : 'M46 23q10 9 20 0l-4 8H50Z'
                    }
                    fill="var(--amber)"
                    stroke="var(--illustration-line)"
                    stroke-width="2"
                    stroke-dasharray="3 2"
                  />
                  <g class="diagram-marker">
                    <circle cx="16" cy="16" r="12" />
                    <text x="16" y="20" text-anchor="middle">
                      {i + 1}
                    </text>
                  </g>
                </g>
              ))}
            </>
          )}
          {diagramId === 'prevention' && (
            <>
              <path
                d="M70 55 180 135 290 55M70 215 180 135 290 215"
                class="connector"
              />
              <path
                d="m180 95 35 12v32c0 24-35 42-35 42s-35-18-35-42v-32Z"
                class="enamel"
              />
              <CareMotif kind="tooth" x={154} y={109} size={52} />
              {(['brush', 'paste', 'water', 'calendar'] as const).map(
                (kind, i) => {
                  const x = i % 2 === 0 ? 20 : 240;
                  const y = i < 2 ? 4 : 166;
                  return (
                    <g data-region={i} transform={`translate(${x} ${y})`}>
                      <rect
                        width="100"
                        height="100"
                        rx="25"
                        class={`stage stage-${i}`}
                      />
                      <CareMotif kind={kind} x={15} y={8} size={78} />
                      <g class="diagram-marker">
                        <circle cx="12" cy="12" r="12" />
                        <text x="12" y="16" text-anchor="middle">
                          {i + 1}
                        </text>
                      </g>
                    </g>
                  );
                },
              )}
            </>
          )}
        </svg>
      )}
    </div>
    <div>
      <p class="text-small muted" data-diagram-hint hidden>
        {t.diagramHint}
      </p>
      <ol class="diagram-steps">
        {copy.steps.map(([label, description], index) => (
          <li>
            <button data-step={index} aria-pressed="false" hidden>
              {label}
            </button>
            <strong class="static-label">{label}</strong>
            <p>{description}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</figure>
<script>
  document.querySelectorAll<HTMLElement>('[data-diagram]').forEach((figure) => {
    figure.querySelector<HTMLElement>('[data-diagram-hint]')!.hidden = false;
    figure
      .querySelectorAll<HTMLElement>('.static-label')
      .forEach((label) => (label.hidden = true));
    figure
      .querySelectorAll<HTMLButtonElement>('[data-step]')
      .forEach((button) => {
        button.hidden = false;
        button.addEventListener('click', () => {
          figure
            .querySelectorAll('[data-step]')
            .forEach((item) =>
              item.setAttribute('aria-pressed', String(item === button)),
            );
          figure
            .querySelectorAll('[data-region]')
            .forEach((region) =>
              region.classList.toggle(
                'selected-region',
                region.getAttribute('data-region') === button.dataset.step,
              ),
            );
        });
      });
  });
</script>
