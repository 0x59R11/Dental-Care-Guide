---
import Tooth from './Tooth.astro';
import LesionStages from './LesionStages.astro';
import { diagrams } from '../../i18n/diagrams';
import { ui } from '../../i18n/ui';
import type { Locale } from '../../i18n/locales';
import type { DiagramId } from '../../data/course';
interface Props {
  locale: Locale;
  diagramId: DiagramId;
}
const { locale, diagramId } = Astro.props;
const copy = diagrams[locale][diagramId];
const t = ui(locale);
---

<figure class="diagram card" data-diagram>
  <figcaption>
    <p class="eyebrow">{t.diagram}</p>
    <h2>{copy.title}</h2>
    <p class="text-small muted">{t.schematic}</p>
    {diagramId === 'dark-spots' && <p class="text-small">{t.notDiagnostic}</p>}
  </figcaption>
  <div class="diagram-layout">
    <div class="diagram-art">
      {diagramId === 'understanding-teeth' ? (
        <Tooth decorative={false} title={copy.title} />
      ) : (
        <svg
          viewBox="0 0 360 270"
          role="img"
          aria-label={copy.title}
          class="process-svg"
        >
          {diagramId === 'how-cavities-develop' && (
            <>
              <path d="M35 135H325" class="connector" />
              {[0, 1, 2, 3].map((step) => (
                <g
                  data-region={step}
                  transform={`translate(${7 + step * 89},35)`}
                >
                  <rect
                    width="78"
                    height="200"
                    rx="24"
                    class={`stage stage-${step}`}
                  />
                  <text x="39" y="30" text-anchor="middle">
                    {step + 1}
                  </text>
                  <path d="M7 145H71V178H7Z" class="dentin" />
                  <path d="M7 137H71V149H7Z" class="enamel" />
                  <path
                    d="M7 120Q23 111 39 120T71 120V136H7Z"
                    fill="var(--soft)"
                    stroke="var(--accent)"
                    stroke-dasharray="3 3"
                  />
                  {[18, 32, 46, 60].map((x, i) => (
                    <ellipse
                      cx={x}
                      cy={130 - (i % 2) * 7}
                      rx="6"
                      ry="4"
                      fill="var(--accent)"
                      transform={`rotate(${i % 2 ? 25 : -25} ${x} 130)`}
                    />
                  ))}
                  {step === 1 && (
                    <g class="dentin">
                      <rect
                        x="18"
                        y="65"
                        width="16"
                        height="16"
                        rx="2"
                        transform="rotate(20 26 73)"
                      />
                      <rect
                        x="48"
                        y="87"
                        width="16"
                        height="16"
                        rx="2"
                        transform="rotate(-15 56 95)"
                      />
                    </g>
                  )}
                  {step === 2 && (
                    <g class="pulp">
                      <path d="M25 65q-14 24 0 24t0-24M53 85q-14 24 0 24t0-24" />
                    </g>
                  )}
                  {step === 3 && (
                    <>
                      <path
                        d="M24 146v-12m15 12v-12m15 12v-12"
                        stroke="var(--dentin)"
                        stroke-width="5"
                      />
                      <circle cx="22" cy="100" r="4" class="dentin" />
                      <circle cx="43" cy="80" r="4" class="dentin" />
                      <circle cx="59" cy="104" r="4" class="dentin" />
                      <path d="M39 117v-14m-5 6 5-6 5 6" class="arrow-path" />
                    </>
                  )}
                </g>
              ))}
            </>
          )}
          {diagramId === 'sugar-food-and-acids' && (
            <>
              <path d="M45 65H320M45 135H320M45 205H320" class="connector" />
              {[0, 1, 2].map((row) => (
                <g data-region={row}>
                  <text x="17" y={72 + 70 * row}>
                    {row + 1}
                  </text>
                  {(row === 1
                    ? [65, 110, 155, 200, 245, 290]
                    : [65, 90, 115]
                  ).map((x) => (
                    <circle
                      cx={x}
                      cy={65 + row * 70}
                      r="10"
                      class={row === 2 ? 'pulp' : 'dentin'}
                    />
                  ))}
                  {row === 2 && (
                    <path d="m180 190-12 29h24z m48 0-12 29h24z" class="pulp" />
                  )}
                </g>
              ))}
            </>
          )}
          {diagramId === 'saliva-and-fluoride' && (
            <>
              <path d="M30 170H330V240H30Z" class="enamel" />
              {[60, 110, 160, 210, 260, 310].map((x) => (
                <rect
                  x={x - 12}
                  y="185"
                  width="24"
                  height="24"
                  rx="4"
                  class="dentin"
                />
              ))}
              <g data-region="0">
                <path d="M95 155V65m-12 15 12-15 12 15" class="arrow-path" />
                <circle cx="65" cy="105" r="8" class="dentin" />
                <text x="95" y="40" text-anchor="middle">
                  1
                </text>
              </g>
              <g data-region="1">
                <path d="M265 65V155m-12-15 12 15 12-15" class="arrow-path" />
                <circle cx="295" cy="105" r="8" class="dentin" />
                <text x="265" y="40" text-anchor="middle">
                  2
                </text>
              </g>
            </>
          )}
          {(diagramId === 'dark-spots' || diagramId === 'lesion-depth') && (
            <LesionStages diagramId={diagramId} />
          )}
          {diagramId === 'when-problems-progress' && (
            <>
              <path
                d="M70 135 265 45M70 135H265M70 135 265 225"
                class="connector"
              />
              {[
                [55, 135],
                [290, 45],
                [290, 135],
                [290, 225],
              ].map(([x, y], i) => (
                <g data-region={i}>
                  <circle cx={x} cy={y} r="32" class={`stage stage-${i}`} />
                  <text x={x} y={y + 7} text-anchor="middle">
                    {i + 1}
                  </text>
                </g>
              ))}
            </>
          )}
          {diagramId === 'prevention' && (
            <>
              <path
                d="M75 55 180 135 285 55M75 215 180 135 285 215"
                class="connector"
              />
              <path
                d="m180 90 40 15v35c0 25-40 45-40 45s-40-20-40-45v-35z"
                class="enamel"
              />
              {[
                [65, 50],
                [295, 50],
                [65, 220],
                [295, 220],
              ].map(([x, y], i) => (
                <g data-region={i}>
                  <circle cx={x} cy={y} r="30" class={`stage stage-${i}`} />
                  <text x={x} y={y + 7} text-anchor="middle">
                    {i + 1}
                  </text>
                </g>
              ))}
            </>
          )}
        </svg>
      )}
    </div>
    <div>
      <p class="text-small muted" data-diagram-hint hidden>
        {t.diagramHint}
      </p>
      <ol class="diagram-steps">
        {copy.steps.map(([label, description], index) => (
          <li>
            <button data-step={index} aria-pressed="false" hidden>
              {label}
            </button>
            <strong class="static-label">{label}</strong>
            <p>{description}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</figure>
<script>
  document.querySelectorAll<HTMLElement>('[data-diagram]').forEach((figure) => {
    figure.querySelector<HTMLElement>('[data-diagram-hint]')!.hidden = false;
    figure
      .querySelectorAll<HTMLElement>('.static-label')
      .forEach((label) => (label.hidden = true));
    figure
      .querySelectorAll<HTMLButtonElement>('[data-step]')
      .forEach((button) => {
        button.hidden = false;
        button.addEventListener('click', () => {
          figure
            .querySelectorAll('[data-step]')
            .forEach((item) =>
              item.setAttribute('aria-pressed', String(item === button)),
            );
          figure
            .querySelectorAll('[data-region]')
            .forEach((region) =>
              region.classList.toggle(
                'selected-region',
                region.getAttribute('data-region') === button.dataset.step,
              ),
            );
          figure
            .querySelectorAll('.diagram-steps li')
            .forEach((item) =>
              item.classList.toggle(
                'selected-step',
                item === button.parentElement,
              ),
            );
        });
      });
  });
</script>
